 ===== LLM 配置（必填，否则 AI 功能不可用）=====
# DeepSeek 平台申请：https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# ===== 数据库 =====
# 本地开发默认 SQLite 零配置；Docker 部署时改用 MySQL：
# DATABASE_URL=mysql+pymysql://root:root123@localhost:3306/law_contract?charset=utf8mb4

# ===== 安全 =====
SECRET_KEY=lc-ai-dev-secret-key-2026-change-in-production-64chars-min-please

# ===== 向量检索 =====
# 默认使用轻量哈希向量（无需下载模型）。如需语义检索，安装 sentence-transformers 后此配置生效
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
